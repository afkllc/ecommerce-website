# AllPencils Task 0 env contract
# Copy only the values you actually need into each app's local environment file.
# Task 0 is intentionally local-first and does not require a runnable backend yet.

# Storefront
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Created by the live Phase 1 seed and required for real catalogue browsing.
MEDUSA_PUBLISHABLE_KEY=
# Optional checkout preferences. Leave blank to use the first live enabled Medusa option.
NEXT_PUBLIC_MEDUSA_SHIPPING_OPTION_NAME=
NEXT_PUBLIC_MEDUSA_PAYMENT_PROVIDER_ID=

# Backend
DATABASE_URL=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string
# Set true on memory-constrained prototype hosts to disable the Medusa Admin build/runtime.
DISABLE_MEDUSA_ADMIN=false
# Required only when running the admin bootstrap script.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=
